# BookMania Backend - variables de entorno
# Referencia de las variables que lee application.properties.
# En producción se definen en Render (render.yaml las declara; los secretos
# se rellenan en el panel al crear el Blueprint). Nunca subas valores reales.

# --- Base de datos ---
# Opción A (producción, Neon): una sola variable con la cadena de conexión.
# DatabaseUrlEnvironmentPostProcessor la convierte a JDBC + usuario/contraseña.
# Usa la conexión DIRECTA (host sin "-pooler").
# DATABASE_URL=postgresql://usuario:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Opción B (local): las tres propiedades por separado (estos son los valores por defecto).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bookmania_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- JWT ---
# Clave en Base64 de al menos 32 bytes. Genera una con: openssl rand -base64 48
JWT_SECRET_KEY=
JWT_EXPIRATION=86400000

# --- CORS ---
# Orígenes del frontend separados por comas, sin barra final.
# Producción: https://bookmania.vercel.app (la URL que te dé Vercel)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- JPA ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- JVM (opcional) ---
# Sobrescribe los flags del Dockerfile (-Xmx320m, SerialGC...)
# JAVA_OPTS=
